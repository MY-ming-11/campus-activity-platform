# 部署配置。用法：
#   cp .env.example .env
#   改掉下面两个密码，然后 docker compose up -d --build
#
# .env 已经被 .gitignore 排除，不会进仓库。这个文件本身是模板，不要往里写真实密码。

# MySQL root 密码。空着的话代码里的默认值会生效，但那只适合本机开发。
MYSQL_ROOT_PASSWORD=change-me-to-a-strong-password

# JWT 签名密钥，至少 32 字节。生成一个随机的：
#   openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-string-at-least-32-bytes

# 前端对外端口。服务器上是 80；本机 80 被占用时改成 8000。
WEB_PORT=80

# 后端对外端口，用来访问接口文档。不想对外暴露就不填，默认 8080。
API_PORT=8080

# 报名并发策略：redis（默认）/ pessimistic / optimistic
# 三者实现见 com.luosh.activity.service.strategy 包
SIGNUP_STRATEGY=redis

# 是否允许请求头 X-Signup-Strategy 临时切换策略。
# 只有做三种方案的对比实验时才改成 true，生产环境必须保持 false。
SIGNUP_ALLOW_OVERRIDE=false
